# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Conta de administrador criada no primeiro arranque (apenas se a base de dados estiver vazia).
# Se ADMIN_PASSWORD não for definida, usa "admin123" - altere após o primeiro acesso.
ADMIN_EMAIL="admin@vidaline.co.ao"
ADMIN_PASSWORD=""

# Base de dados Supabase (OBRIGATÓRIO).
# Supabase > Project Settings > Database > Connection string > "Session pooler" (porta 5432).
# Substitua [YOUR-PASSWORD] pela senha do banco definida ao criar o projeto.
DATABASE_URL="postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-xx.pooler.supabase.com:5432/postgres"

# Opcional: porta do servidor
# PORT=3000
